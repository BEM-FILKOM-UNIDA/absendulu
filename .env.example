# Copy to .env.local and fill in. Never commit .env.local.
# Get these from Supabase → Project Settings → API.
# Note the names: the publishable key is NEXT_PUBLIC_* (it ships to the browser),
# the secret key is NOT (it stays server-side and bypasses RLS).

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx

# Legacy aliases still work if you're migrating: NEXT_PUBLIC_SUPABASE_ANON_KEY
# and SUPABASE_SERVICE_ROLE_KEY. The deploy workflow rejects the legacy names
# on purpose, so prefer the modern pair.