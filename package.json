{
  "name": "absen",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && tsc --noEmit",
    "start": "node --env-file-if-exists=.env.local .output/server/index.mjs",
    "preview": "vite preview",
    "test:schedule": "node scripts/test-schedule.mjs",
    "lint": "eslint src vite.config.ts",
    "typecheck": "tsc --noEmit",
    "check": "bun run test:schedule && bun run lint && bun run typecheck && bun run build"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.5",
    "@supabase/supabase-js": "2.112.4",
    "@tanstack/react-router": "1.170.32",
    "@tanstack/react-start": "1.168.49",
    "html5-qrcode": "2.3.8",
    "qrcode": "1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "20.19.25",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "9.39.2",
    "nitro": "3.0.260610-beta",
    "tailwindcss": "4.2.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2"
  }
}
